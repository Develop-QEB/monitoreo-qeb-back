NODE_ENV=development
PORT=4001

# Connection a schema dashboard_dev en cluster qeb-mysql-dev de DigitalOcean
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/dashboard_dev?sslaccept=accept_invalid_certs"

# QEB producción · SOLO LECTURA (usuario monitor_readonly con GRANT SELECT)
# Usado por endpoints /api/qeb/* que muestran datos de negocio en el monitor
DATABASE_URL_QEB="mysql://monitor_readonly:PASSWORD@qeb-mysql-prod-...:25060/u658050396_QEB"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: comma-separated list de orígenes permitidos
CORS_ORIGINS=http://localhost:5175,https://admin.qeb.mx

# ------- INTEGRACIONES DE INFRA (opcionales) -------
# Si no se configuran, /api/infra/* responde configured=false y el front muestra un aviso.

# Vercel · para deploys/uptime del front prod de QEB
# Token: https://vercel.com/account/tokens (scope read)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=       # ID del proyecto front-qeb en Vercel
VERCEL_TEAM_ID=          # opcional, solo si el proyecto vive en un team

# DigitalOcean · para deploys de qeb-back y metrics del cluster
# Token: cloud.digitalocean.com > API > Tokens > Generate New Token (scope read)
DO_API_TOKEN=
DO_APP_ID_QEB_BACK=      # UUID del App qeb-back
DO_DB_CLUSTER_ID=        # UUID del cluster qeb-mysql-prod
