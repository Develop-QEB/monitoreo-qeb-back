NODE_ENV=development
PORT=4001

# Connection a schema dashboard_dev en cluster qeb-mysql-dev de DigitalOcean
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/dashboard_dev?sslaccept=accept_invalid_certs"

# QEB producción · SOLO LECTURA (usuario monitor_readonly con GRANT SELECT)
# Usado por endpoints /api/qeb/* que muestran datos de negocio en el monitor
DATABASE_URL_QEB="mysql://monitor_readonly:PASSWORD@qeb-mysql-prod-...:25060/u658050396_QEB"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: comma-separated list de orígenes permitidos
CORS_ORIGINS=http://localhost:5175,https://monitoreo-qeb.vercel.app
